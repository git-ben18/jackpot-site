# S3-E low-privilege public-read identity (D-S3-05).
# Server-only. Do not put values in NEXT_PUBLIC_*.
# Do not set SUPABASE_SERVICE_ROLE_KEY for this application path.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Explicit anon compatibility fallback only if publishable keys are not enabled.
# Must remain the same low-privilege class. Never a service-role/secret substitute.
# SUPABASE_ANON_KEY=
