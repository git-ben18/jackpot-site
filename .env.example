# Low-privilege curated discovery (DB-W3 / S3-E). Server-side only.
# Never set service-role credentials for this path.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional compatibility fallback if the project has not enabled publishable keys.
# Same privilege class as anon — not a service-role substitute.
# SUPABASE_ANON_KEY=

# Opt-in fixture path for local/dev tests only.
# Ignored when NODE_ENV=production even if set.
# CURATED_PROMO_DISCOVERY_MOCK=1

# Canonical newsletter service (S4-C BFF). Server-only. Not a browser/NEXT_PUBLIC value.
NEWSLETTER_SERVICE_BASE_URL=

# Acquisition kill switch (S4-F). Server-authoritative. Never restores a legacy subscribe writer.
# Unset or true-like → allowed for local/dev. false-like or unknown → disabled (fail closed).
# Public DOI launch still requires Hosted Acceptance / release control.
# NEWSLETTER_ACQUISITION_ENABLED=1
# NEWSLETTER_ACQUISITION_ENABLED=0

# Workload identity (S4-D). Omit or set `vercel_oidc` for the production design.
# `fake` is local/test only — rejected when NODE_ENV=production or VERCEL_ENV is
# preview/production.
# NEWSLETTER_WORKLOAD_IDENTITY_MODE=vercel_oidc

# Optional OIDC audience for token exchange. Leave unset until EB-03 freezes
# the accepted audience for the deployed topology.
# NEWSLETTER_WORKLOAD_OIDC_AUDIENCE=

# Local/test fake assertion when NEWSLETTER_WORKLOAD_IDENTITY_MODE=fake.
# Deterministic test value only — not a production credential.
# NEWSLETTER_WORKLOAD_IDENTITY_FAKE_ASSERTION=

# Provided by Vercel runtime / `vercel env pull` for local OIDC development.
# Do not invent a long-lived shared bearer substitute.
# VERCEL_OIDC_TOKEN=
