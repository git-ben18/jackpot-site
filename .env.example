# Low-privilege curated discovery (DB-W3 / S3-E). Server-side only.
# Never set service-role credentials for this path.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional compatibility fallback if the project has not enabled publishable keys.
# Same privilege class as anon — not a service-role substitute.
# SUPABASE_ANON_KEY=

# Opt-in fixture path for local/dev tests only. Never rely on this in production.
# CURATED_PROMO_DISCOVERY_MOCK=1
